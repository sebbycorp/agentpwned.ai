---
import { badgeClass, labNumber, statusLabel, type LabEntry } from '../lib/labs';

interface StepLink {
	href: string;
	title: string;
	order: number;
	id: string;
}

interface StatusTone {
	canary?: string;
	sink?: string;
	legit?: string;
	plane?: string;
}

interface Props {
	lab: LabEntry;
	progress: string;
	heading: string;
	lede?: string;
	steps: StepLink[];
	currentId: string;
	status?: StatusTone | null;
	prev?: { href: string; title: string } | null;
	next?: { href: string; title: string } | null;
	predict?: string;
	reveal?: string;
	answer?: string;
}

const { lab, progress, heading, lede, steps, currentId, status = null, prev = null, next = null, predict, reveal, answer } = Astro.props;

function tone(value: string | undefined): string {
	if (!value) return '';
	const lower = value.toLowerCase();
	if (lower.includes('200') || lower.includes('hidden') || lower.includes('blocked') || lower === 'envoy') return 'ok';
	if (lower.includes('leak') || lower.includes('visible') || lower.includes('placeholder') || lower.includes('none')) return 'bad';
	return '';
}
const number = labNumber(lab.data.order);
const overviewHref = `/labs/${lab.id}/`;
---

<article class="lab tutorial">
	<div class="wrap">
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href="/labs/">Labs</a>
			<span aria-hidden="true">/</span>
			<a href={overviewHref}>Lab {number}</a>
			<span aria-hidden="true">/</span>
			<span>{progress}</span>
		</nav>
		<header class="lab-head">
			<p class="kicker">
				<span>Lab {number}</span>
				<span class={badgeClass(lab.data.status)}>{statusLabel(lab.data.status)}</span>
				<span>{progress}</span>
				{lab.data.duration && <span>{lab.data.duration}</span>}
			</p>
			<h1>{heading}</h1>
			{lede && <p class="lede">{lede}</p>}
			{
				lab.data.status === 'draft' && (
					<p class="banner note" role="status">
						Draft. Run it only on a local kind cluster, with canary secrets.
					</p>
				)
			}
			<p class="safety">Repo path: labs/{lab.id}. All lab attacks run only on a local kind cluster.</p>
		</header>
		<div class="lab-layout">
			<nav class="section-nav step-nav" aria-label="Tutorial steps">
				<p class="kicker">Steps</p>
				<ol>
					<li>
						<a href={overviewHref} aria-current={currentId === 'overview' ? 'step' : undefined}>Overview</a>
					</li>
					{
						steps.map((step) => (
							<li>
								<a href={step.href} aria-current={step.id === currentId ? 'step' : undefined}>
									<span class="step-index">{String(step.order).padStart(2, '0')}</span>
									{step.title}
								</a>
							</li>
						))
					}
				</ol>
			</nav>
			<div class="lab-body">
				{
					status && (
						<dl class="status" aria-label="Run status">
							<div>
								<dt>Canary</dt>
								<dd class={tone(status.canary)}>{status.canary}</dd>
							</div>
							<div>
								<dt>Sink</dt>
								<dd class={tone(status.sink)}>{status.sink}</dd>
							</div>
							<div>
								<dt>Legit call</dt>
								<dd class={tone(status.legit)}>{status.legit}</dd>
							</div>
							<div>
								<dt>Dataplane</dt>
								<dd class={tone(status.plane)}>{status.plane}</dd>
							</div>
						</dl>
					)
				}
				<slot />
				{
					predict && (
						<form class="predict" data-predict={predict}>
							<p class="predict-label">Predict</p>
							<button type="button" data-choice="leaks" aria-pressed="false">
								Leaks
							</button>
							<button type="button" data-choice="blocked" aria-pressed="false">
								Blocked
							</button>
						</form>
					)
				}
				{
					reveal && answer && (
						<p class="reveal" data-reveal={reveal} data-answer={answer}>
							<span data-reveal-text>Pick a guess on the predict step to compare it here.</span>
						</p>
					)
				}
				<nav class="pager" aria-label="Step">
					{
						prev ? (
							<a class="button secondary" href={prev.href}>
								Back
								<span>{prev.title}</span>
							</a>
						) : (
							<span></span>
						)
					}
					{
						next ? (
							<a
								class:list={['button', 'pager-next', { 'is-locked': Boolean(predict) }]}
								href={next.href}
								aria-disabled={predict ? 'true' : undefined}
								tabindex={predict ? -1 : undefined}
								data-predict-next={predict || undefined}
							>
								Next
								<span>{next.title}</span>
							</a>
						) : (
							<span></span>
						)
					}
				</nav>
			</div>
		</div>
	</div>
</article>
<script is:inline>
	const labels = { leaks: 'Leaks', blocked: 'Blocked' };
	const form = document.querySelector('[data-predict]');
	const next = document.querySelector('[data-predict-next]');
	if (form && next) {
		const key = 'lab01-predict-' + form.getAttribute('data-predict');
		const buttons = form.querySelectorAll('[data-choice]');
		const unlock = (choice) => {
			localStorage.setItem(key, choice);
			buttons.forEach((button) => {
				button.setAttribute('aria-pressed', button.getAttribute('data-choice') === choice ? 'true' : 'false');
			});
			next.classList.remove('is-locked');
			next.removeAttribute('aria-disabled');
			next.removeAttribute('tabindex');
		};
		buttons.forEach((button) => {
			button.addEventListener('click', () => unlock(button.getAttribute('data-choice')));
		});
		const stored = localStorage.getItem(key);
		if (stored === 'leaks' || stored === 'blocked') unlock(stored);
		next.addEventListener('click', (event) => {
			if (next.classList.contains('is-locked')) event.preventDefault();
		});
	}
	const reveal = document.querySelector('[data-reveal]');
	if (reveal) {
		const key = 'lab01-predict-' + reveal.getAttribute('data-reveal');
		const answer = reveal.getAttribute('data-answer');
		const guess = localStorage.getItem(key);
		const answerLabel = labels[answer] || answer;
		const text = reveal.querySelector('[data-reveal-text]');
		if (text) {
			if (guess !== 'leaks' && guess !== 'blocked') {
				text.textContent = 'No guess stored in this browser. The run: ' + answerLabel + '.';
			} else if (guess === answer) {
				text.textContent = 'You guessed ' + labels[guess] + '. The run matched: ' + answerLabel + '.';
			} else {
				text.textContent = 'You guessed ' + labels[guess] + '. The run: ' + answerLabel + '.';
			}
		}
	}
</script>
