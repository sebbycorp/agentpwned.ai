---
import { labNumber, statusLabel, type LabEntry } from '../lib/labs';

interface Props {
	lab: LabEntry;
	level?: 2 | 3;
}

const { lab, level = 3 } = Astro.props;
const Title = level === 2 ? 'h2' : 'h3';
const number = labNumber(lab.data.order);
const badgeClass =
	lab.data.status === 'available' ? 'badge ready' : lab.data.status === 'template' ? 'badge template' : 'badge';
---

<a class="card" href={`/labs/${lab.id}/`}>
	<p class="kicker">
		<span>Lab {number}</span>
		<span class={badgeClass}>{statusLabel(lab.data.status)}</span>
	</p>
	<Title>{lab.data.title}</Title>
	<p>{lab.data.summary}</p>
</a>
