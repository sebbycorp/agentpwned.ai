---
import { getCollection, render } from 'astro:content';
import TutorialShell from '../../components/TutorialShell.astro';
import Base from '../../layouts/Base.astro';
import { badgeClass, labNumber, statusLabel } from '../../lib/labs';

export async function getStaticPaths() {
	const labs = await getCollection('labs');
	return labs.map((lab) => ({
		params: { slug: lab.id },
		props: { lab },
	}));
}

const { lab } = Astro.props;
const { Content, headings } = await render(lab);
const number = labNumber(lab.data.order);
const label = lab.data.kind === 'template' ? 'Template' : `Lab ${number}`;
const sections = headings.filter((heading) => heading.depth === 2);
const tutorialSteps = (await getCollection('steps'))
	.filter((step) => step.data.lab === lab.id)
	.sort((a, b) => a.data.order - b.data.order)
	.map((step) => ({
		href: `/labs/${lab.id}/${step.id.slice(lab.id.length + 1)}/`,
		title: step.data.title,
		order: step.data.order,
		id: step.id,
	}));
const firstStep = tutorialSteps[0];
---

<Base title={`${label}: ${lab.data.title}`} description={lab.data.summary} current={lab.data.kind === 'template' ? 'template' : 'lab'}>
	{
		firstStep ? (
			<TutorialShell
				lab={lab}
				progress="Overview"
				heading={lab.data.title}
				steps={tutorialSteps}
				currentId="overview"
				next={{ href: firstStep.href, title: firstStep.title }}
			>
				<Content />
			</TutorialShell>
		) : (
	<article class="lab">
		<div class="wrap">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/labs/">Labs</a>
				<span aria-hidden="true">/</span>
				<span>{label}</span>
			</nav>
			<header class="lab-head">
				<p class="kicker">
					<span>{label}</span>
					<span class={badgeClass(lab.data.status)}>{statusLabel(lab.data.status)}</span>
					{lab.data.duration && <span>{lab.data.duration}</span>}
					{lab.data.difficulty && <span>{lab.data.difficulty}</span>}
				</p>
				<h1>{lab.data.title}</h1>
				{lab.data.status !== 'draft' && <p class="lede">{lab.data.summary}</p>}
				{
					lab.data.status === 'coming-soon' && (
						<p class="banner" role="status">
							Coming soon. The runnable steps are not published yet. When they land, they run only in an isolated local
							lab.
						</p>
					)
				}
				{
					lab.data.status === 'available' && (
						<p class="banner" role="status">
							Ready to run. All lab attacks run only in isolated, local lab environments.
						</p>
					)
				}
				{
					lab.data.status === 'draft' && (
						<p class="banner note" role="status">
							Draft. This page is the lab in the repo. Run it only on a local kind cluster, with canary secrets.
						</p>
					)
				}
				{
					lab.data.kind === 'template' && (
						<p class="banner note">
							Author template. Copy this file when you add a lab. Readers do not run this page.
						</p>
					)
				}
				{lab.data.kind === 'lab' && lab.data.status !== 'draft' && (
					<p class="safety">All lab attacks run only in isolated, local lab environments.</p>
				)}
				{lab.data.status === 'draft' && (
					<p class="safety">
						Repo path: labs/{lab.id}. All lab attacks run only on a local kind cluster.
					</p>
				)}
			</header>
			<div class="lab-layout">
				<nav class="section-nav" aria-label="Lab sections">
					<p class="kicker">On this page</p>
					<ol>
						{
							sections.map((section) => (
								<li>
									<a href={`#${section.slug}`}>{section.text}</a>
								</li>
							))
						}
					</ol>
				</nav>
				<div class="lab-body">
					<Content />
				</div>
			</div>
		</div>
	</article>
		)
	}
</Base>
